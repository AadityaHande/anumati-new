DATABASE_URL=jdbc:postgresql://localhost:5432/anumati
DATABASE_USERNAME=anumati
# Spring Boot reads environment variables. This file is a reference template for local setup.
DATABASE_PASSWORD=anumati-local
ANUMATI_ADMIN_USERNAME=admin
ANUMATI_ADMIN_PASSWORD=change-me
ANUMATI_APPLICANT_USERNAME=applicant
ANUMATI_APPLICANT_PASSWORD=change-me
REQUIRE_VERIFIED_SOURCES=true
ANUMATI_ALLOWED_ORIGINS=http://localhost:3000

# Storage is S3-compatible. For development this can point to Supabase Storage S3.
# For production, point the same contract at AWS S3 and leave endpoint empty.
ANUMATI_STORAGE_BUCKET=anumati-documents
ANUMATI_STORAGE_REGION=ap-south-1
ANUMATI_STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
ANUMATI_STORAGE_ACCESS_KEY=
ANUMATI_STORAGE_SECRET_KEY=
ANUMATI_STORAGE_PRESIGN_MINUTES=10
ANUMATI_STORAGE_MAX_FILE_BYTES=10485760

PORT=8080

ANUMATI_OFFICER_USERNAME=officer
ANUMATI_OFFICER_PASSWORD=change-me

ANUMATI_SESSION_COOKIE_NAME=ANUMATI_SESSION
ANUMATI_SESSION_LIFETIME_HOURS=8
ANUMATI_SESSION_SECURE_COOKIE=false
ANUMATI_SESSION_COOKIE_DOMAIN=

ANUMATI_SCRUTINY_ENHANCED_INVESTMENT_INR=1000000000
ANUMATI_SCRUTINY_ENHANCED_EMPLOYEE_THRESHOLD=250

# Local judging mode (no cloud storage account required)
ANUMATI_STORAGE_MODE=local
ANUMATI_STORAGE_LOCAL_ROOT=.data/documents
ANUMATI_STORAGE_LOCAL_BASE_URL=http://localhost:8080
